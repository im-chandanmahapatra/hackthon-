# Database Connection URL (SQLite default, easily switchable to Supabase/PostgreSQL)
# SQLite: sqlite:///./argus.db
# PostgreSQL / Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./argus.db

# Confidence Threshold for AI Detection
CONFIDENCE_THRESHOLD=0.50
