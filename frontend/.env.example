# SentinelView — Frontend Environment Variables
# ------------------------------------------------
# Copy this file to .env and fill in values.
# cp .env.example .env

# Base URL for the FastAPI backend
# - Leave empty during mock-mode development (USE_MOCK=true in api/client.ts)
# - Set to http://localhost:8000 when running the real backend
VITE_API_BASE_URL=http://localhost:8000
